# Copy to .env.local for local development. Never commit real values.
# Production on Endora cannot set environment variables: it uses the PHP config
# file described in docs/support-setup.md (template:
# backend/config/support-config.example.php) with the same keys.

# --- Existing contact form (EmailJS). NEXT_PUBLIC_* values end up in the browser.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Support backend (PHP, server-only) ---------------------------------------
# NEVER prefix any of the values below with NEXT_PUBLIC_.

# production | development | test. Missing = production (fails safe).
SUPPORT_ENV=development

# MySQL/MariaDB. Local default matches `npm run support:test-db` + a support_dev DB.
SUPPORT_DB_HOST=127.0.0.1
SUPPORT_DB_PORT=3306
SUPPORT_DB_NAME=support
SUPPORT_DB_USER=support
SUPPORT_DB_PASSWORD=change-me

# Secret used to HMAC IPs/emails for rate limiting. 32+ random characters.
# Generate: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
SUPPORT_HASH_SECRET=replace-with-64-random-hex-characters

# Protects /api/support/cron.php (retry job). 32+ random characters.
SUPPORT_CRON_SECRET=replace-with-64-random-hex-characters
# Optional: only accept cron calls from these IPs (Endora cron servers listed).
# SUPPORT_CRON_ALLOWED_IPS=62.109.128.59,212.57.32.9,62.109.150.10,212.57.32.162
# Optional: seconds the cron run may spend (keep below the host's PHP time limit).
# SUPPORT_CRON_TIME_BUDGET_SECONDS=20

# Browser origins allowed to submit the form (recommended in production).
# SUPPORT_ALLOWED_ORIGINS=https://berycode.cz,https://www.berycode.cz
# Only if the host's own proxy sets it (see docs): e.g. X-Real-IP
# SUPPORT_CLIENT_IP_HEADER=

# Optional rate-limit overrides (defaults shown).
# SUPPORT_RATE_LIMIT_IP_PER_10_MIN=10
# SUPPORT_RATE_LIMIT_IP_PER_DAY=40
# SUPPORT_RATE_LIMIT_EMAIL_PER_HOUR=5
# SUPPORT_RATE_LIMIT_GLOBAL_PER_HOUR=100

# Slack (single workspace). Bot token needs only the chat:write scope.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_TEAM_ID=T0123456789
# Optional but recommended: rejects payloads from other apps.
SLACK_APP_ID=A0123456789
# Slack member IDs allowed to use the ticket buttons (comma-separated).
SLACK_ALLOWED_STAFF_USER_IDS=U0123456789

# Language of the Slack messages: cs | en
SUPPORT_SLACK_LOCALE=cs
# HTTP timeout for Slack calls in seconds (Endora Free: keep <= 5).
# SUPPORT_SLACK_TIMEOUT_SECONDS=8

# Development only (refused when SUPPORT_ENV=production): log Slack payloads to
# a file instead of calling Slack. Use an absolute path.
# SUPPORT_SLACK_MODE=mock
# SUPPORT_MOCK_SLACK_LOG=/absolute/path/to/backend/var/mock-slack.log

# Next dev proxies /api/support/* here (npm run support:dev).
# SUPPORT_API_DEV_ORIGIN=http://127.0.0.1:8080
